PORT=3333
DATABASE_URL="file:./dev.db"

# Gere um segredo forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# A duração da sessão (token) vem da preferência do usuário (padrão: 60 min).
JWT_SECRET="troque-este-segredo"

# Origens do front liberadas no CORS (separe por vírgula).
# Live Server do VS Code usa a porta 5500.
CORS_ORIGIN="http://127.0.0.1:5500,http://localhost:5500"

# URL do front, usada no link de recuperação de senha
FRONTEND_URL="http://127.0.0.1:5500"

NODE_ENV=development
